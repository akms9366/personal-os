// Personal OS — Prisma schema
// 設計参照: personal-os-design docs/06_Data_Model.md,
//           docs/99_Reference/State_Taxonomy.md, docs/99_Reference/Glossary.md,
//           docs/14_Implementation_Backlog.md §2（軽量フィールド方式）
//
// 状態区別コア（Issue #3）は「単一 Entry モデル方式」で表現する。
// 派生専用モデル（Interpretation / Suggestion / Decision 等）は作らず、
// Entry に origin / state / sourceEntryId を持たせて原情報・AI派生・利用者決定を区別する。
// 値域の検証と不変条件（AI は原情報を書き換えない 等）は lib/domain のガードで担保する。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Entry — Personal OS の「原情報（Original Information / State Taxonomy S1）」を保持する正本モデル。
///
/// 不変（immutable）前提:
///   - 生成後に内容（kind / body / source）を書き換えない。
///   - 「修正」は既存レコードの更新ではなく、新しい Entry レコードとして版を生成する
///     （14_Implementation_Backlog §11「修正は新版生成」/ State_Taxonomy §3 S1）。
///   - 変更を暗示しないため updatedAt は持たせない。
///   - 「AI は原情報を書き換えない」ことをデータ層で担保するガードは Issue #3 の責務。
model Entry {
  id String @id @default(cuid())

  /// 種別。許容値: "note" | "journal" | "bookmark"。
  /// SQLite は Prisma enum 非対応のため String とし、許容値の検証はドメイン層（Issue #3+）で行う。
  kind String

  /// 原情報の本文。
  body String

  /// 取得時点（不変）。出所・時点を伴う原情報の「時点」（Glossary: Original Information）。
  createdAt DateTime @default(now())

  /// 出所（Source）。例: "manual" | "quick-capture"。
  /// AI を Source としない（Glossary: Source ＝ 原情報の起点であり AI は解釈の生成者）。
  source String

  /// 起源（Origin / 06 §7 所有権）。許容値: "human" | "ai" | "external"。
  /// System（S6/S7 実行系）は Entry の対象外のため含めない。
  /// SQLite は Prisma enum 非対応のため String とし、値域の検証は lib/domain で行う。
  origin String @default("human")

  /// 情報状態（State Taxonomy）。許容値（MVP 軽量サブセット）: "S1" | "S2" | "S4" | "S5"。
  /// S1=原情報 / S2=解釈 / S4=提案 / S5=決定。当面 S1 のみ使用し、語彙は先に固定する。
  state String @default("S1")

  /// 来歴参照（Provenance link / State_Taxonomy §5）。
  /// 派生（state ∈ {S2,S4,S5}）は親 Entry を必須参照。原情報（S1）は null。
  /// 「派生なら必須／原情報なら null」の条件付き必須は lib/domain のガードで担保する。
  /// onDelete: Restrict — 親を削除すると来歴が失われる（SET NULL は Provenance 改ざん防止に反する。
  /// PR #4 レビュー IMPORTANT 指摘、Issue #8（削除機能）着手にあたり解消）。
  sourceEntryId String?
  sourceEntry   Entry?  @relation("EntryProvenance", fields: [sourceEntryId], references: [id], onDelete: Restrict)
  derivedEntries Entry[] @relation("EntryProvenance")

  /// 版参照（Issue #8「修正は新版生成」/ 06 §9・§13「原情報は不変、外部更新は新版追記」）。
  /// 派生の来歴（sourceEntryId）とは別概念: 同じ state=S1 同士を「この Entry は revisesEntryId の新版である」で繋ぐ。
  /// 旧版（revisesEntryId が指す側）は一切書き換えない。一覧は revisedBy が空の Entry のみを「現在版」として表示する。
  /// onDelete: Restrict — 旧版が既に新版を持つ場合、旧版だけを削除して改訂履歴を失うことを防ぐ。
  revisesEntryId String?
  revisesEntry   Entry?  @relation("EntryRevision", fields: [revisesEntryId], references: [id], onDelete: Restrict)
  revisedBy      Entry[] @relation("EntryRevision")

  originatedTasks Task[]
}

/// Task — 利用者が選んだ行動（06 §3.3 系統B。State Taxonomy S4→S5→S6→S7 相当を軽量に扱う）。
/// Entry（原情報 S1）と異なり不変ではない。status/priority は通常の CRUD で更新してよい
/// （`11 §2` 保留・未完了は失敗として扱わない。優先順位は利用者が設定し自動確定しない）。
model Task {
  id String @id @default(cuid())

  title String
  note  String?

  /// 許容値: "todo" | "doing" | "hold" | "done"。値域は lib/domain/task.ts。
  status String @default("todo")

  dueAt DateTime?

  /// 許容値: "low" | "medium" | "high"。未設定（null）を許容する（自動確定しない）。
  priority String?

  createdAt DateTime @default(now())

  /// Quick Capture 由来のタスクが元原情報を参照する（来歴、Issue #12「Capture→Task化」で使用）。
  /// onDelete: Restrict — 元原情報の削除で来歴を失わないため（Issue #8 の sourceEntryId/revisesEntryId と同じ方針）。
  originEntryId String?
  originEntry   Entry?  @relation(fields: [originEntryId], references: [id], onDelete: Restrict)
}

/// Settings — 利用者の制御面（05 §8）。Entry（原情報）とは別概念で、
/// System(Trust & Runtime Foundation層)が保持し利用者のみが更新する構成情報
/// （Module_Layer_Space_Mapping §4「Settings & Consent」）。
///
/// MVP（Issue #6）では Must 範囲の「AI & Automation」枠のみ実データを持つ。
/// Intent & Preferences / Connections / Data & Privacy は後続 Issue（#13, #19 等）で拡張する。
/// 単一ユーザーのため常に1行のみ（シングルトン、id 固定）。
model Settings {
  id String @id @default("singleton")

  /// Claude API キー（14 §3 AI 提供者）。平文で DB に保持する
  /// （自分専用ローカル優先 SQLite が既存の信頼境界。14 §2 により監査・暗号化基盤は追加しない）。
  /// 画面には表示しない（Issue #6 完了条件）。UI 層は末尾数桁のみのマスク表示に限定する。
  aiApiKey String?

  /// 使用モデル。既定は 14 §3 の決定値。
  aiModel String @default("claude-sonnet-5")

  /// Google Calendar 接続（Issue #13）。ICS 秘密URL方式（04 §7 最小権限＝読み取り専用）。
  /// OAuth ではなくこの方式を採用したため、スコープ制御ではなく「ICSは読み取り専用の形式である」
  /// こと自体が最小権限を担保する。値は平文保持（14 §2、Settings.aiApiKey と同じ判断）。
  calendarIcsUrl        String?
  calendarLastSyncAt    DateTime?
  calendarLastSyncError String?

  updatedAt DateTime @updatedAt
}
