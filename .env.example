# Prisma / SQLite
# SQLite の相対パスは prisma/schema.prisma からの相対で解決される（= prisma/dev.db）。
DATABASE_URL="file:./dev.db"

# 単一ユーザー認証（Issue #5）
# AUTH_PASSWORD: ログインパスワード（平文比較。自分専用のため .env.local にのみ置く）。
# AUTH_SESSION_SECRET: セッション Cookie の署名鍵。十分に長いランダム文字列にする
#   （例: `openssl rand -hex 32`）。
AUTH_PASSWORD="change-me"
AUTH_SESSION_SECRET="change-me-to-a-long-random-string"
